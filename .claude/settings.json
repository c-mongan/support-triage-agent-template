{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Read-only support triage defaults. Allow research and saving local reports. Deny destructive shell verbs and any MCP write/mutate calls. Adjust per-product when adding skills.",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Bash(gh:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(jq:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "WebSearch",
      "WebFetch",
      "mcp__deepwiki__*",
      "mcp__context7__*",
      "mcp__plugin_context7_context7__*",
      "mcp__github__search_issues",
      "mcp__github__get_issue",
      "mcp__github__list_pull_requests",
      "mcp__github__get_file_contents",
      "mcp__sentry__*",
      "mcp__linear__list_issues",
      "mcp__linear__get_issue",
      "mcp__slack__search_messages",
      "mcp__slack__list_channels",
      "mcp__slack__get_thread"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(curl -X POST:*)",
      "Bash(curl -X PUT:*)",
      "Bash(curl -X PATCH:*)",
      "Bash(curl -X DELETE:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "mcp__github__create_issue",
      "mcp__github__update_issue",
      "mcp__github__add_issue_comment",
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__linear__create_issue",
      "mcp__linear__update_issue",
      "mcp__sentry__resolve_issue",
      "mcp__sentry__update_issue",
      "mcp__slack__post_message",
      "mcp__slack__update_message",
      "mcp__slack__delete_message"
    ]
  }
}
